---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => import.meta.env.PROD ? !p.data.draft : true)
  .sort((a, b) => b.data.pub_date.valueOf() - a.data.pub_date.valueOf());
---

<BaseLayout
  title="Writing — Alfonso Mayoral"
  description="Notes on shipping AI products, building communities, and surviving the first year as an AI engineer."
>
  <section class="max-w-[var(--container-narrow)] mx-auto px-6 pt-32 pb-12">
    <p class="font-mono text-sm text-[var(--color-accent-hover)] mb-4">Writing</p>
    <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-[var(--color-text-primary)] mb-4">
      Notes from the build
    </h1>
    <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
      Honest writeups of what I&apos;ve shipped, what I&apos;ve broken, and what
      surprised me. Few posts, written when I have something to say.
    </p>
  </section>

  <section class="max-w-[var(--container-narrow)] mx-auto px-6 pb-32">
    <ul class="divide-y divide-[var(--color-border)]">
      {posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            class="block py-6 group"
          >
            <div class="flex items-baseline justify-between gap-4 mb-2">
              <h2 class="text-xl font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-hover)] transition-colors">
                {post.data.title}
                {post.data.draft && (
                  <span class="ml-2 font-mono text-xs text-amber-400">DRAFT</span>
                )}
              </h2>
              <time class="font-mono text-xs text-[var(--color-text-muted)] whitespace-nowrap">
                {post.data.pub_date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
              </time>
            </div>
            <p class="text-[var(--color-text-secondary)] leading-relaxed">
              {post.data.description}
            </p>
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p class="text-[var(--color-text-muted)] py-6">No posts yet.</p>
    )}
  </section>
</BaseLayout>
