---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmbeddingVisualizer from '@/components/EmbeddingVisualizer.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const recentPosts = (await getCollection('blog'))
  .filter((p) => import.meta.env.PROD ? !p.data.draft : true)
  .sort((a, b) => b.data.pub_date.valueOf() - a.data.pub_date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="max-w-[var(--container-content)] mx-auto px-6 pt-32 pb-12">
    <p class="font-mono text-sm text-[var(--color-accent-hover)] mb-6">
      Available for Fall 2026 — Exponential Fellowship
    </p>
    <h1 class="text-5xl md:text-7xl font-semibold tracking-tight text-[var(--color-text-primary)] mb-6">
      Alfonso Mayoral
    </h1>
    <p class="text-xl md:text-2xl text-[var(--color-text-secondary)] max-w-2xl leading-relaxed">
      AI engineer shipping consumer iOS and enterprise GenAI. Madrid, headed west.
    </p>

    <div class="flex flex-wrap items-center gap-4 mt-10">
      <a
        href="/projects"
        class="inline-flex items-center px-5 py-2.5 rounded-md bg-[var(--color-accent)] text-white font-medium text-sm hover:bg-[var(--color-accent-hover)] transition-colors"
      >
        See my work
      </a>
      <a
        href="mailto:alfonsomayoral29@gmail.com"
        class="inline-flex items-center px-5 py-2.5 rounded-md border border-[var(--color-border-strong)] text-[var(--color-text-primary)] font-medium text-sm hover:bg-[var(--color-bg-elevated)] transition-colors"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section class="max-w-[var(--container-content)] mx-auto px-6">
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider">
        Project map
      </h2>
      <p class="text-xs font-mono text-[var(--color-text-muted)]">
        positioned by semantic similarity
      </p>
    </div>
    <EmbeddingVisualizer />
  </section>

  <section class="max-w-[var(--container-content)] mx-auto px-6 py-24">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider">
        Featured projects
      </h2>
      <a
        href="/projects"
        class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
      >
        All projects →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        featured.map((p) => (
          <ProjectCard
            title={p.data.title}
            tagline={p.data.tagline}
            tech={p.data.tech_stack}
            year={p.data.year}
            status={p.data.status}
            href={`/projects/${p.id}`}
          />
        ))
      }
    </div>
  </section>

  <section class="max-w-[var(--container-content)] mx-auto px-6 py-24 border-t border-[var(--color-border)]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <h2 class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider mb-3">
          About
        </h2>
        <a href="/about" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">
          Full bio →
        </a>
      </div>
      <div class="md:col-span-2 space-y-4 text-[var(--color-text-secondary)] leading-relaxed">
        <p>
          Final-year Telecom Engineering at UC3M (top 10 of cohort, GPA 8.7/10).
          One year into production GenAI at Beam Suntory. Spotter is on the
          App Store. AISC Madrid is the AI student community I co-founded —
          the first in Europe.
        </p>
        <p>
          Applying to the Exponential Fellowship for Fall 2026. Headed to
          the Bay Area within the next 18-24 months — as a founder if the
          right problem and team show up, as an early engineer at the right
          startup otherwise.
        </p>
      </div>
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="max-w-[var(--container-content)] mx-auto px-6 py-24 border-t border-[var(--color-border)]">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider">
          Latest writing
        </h2>
        <a
          href="/blog"
          class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        >
          All writing →
        </a>
      </div>
      <ul class="divide-y divide-[var(--color-border)]">
        {recentPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="block py-5 group"
            >
              <div class="flex items-baseline justify-between gap-4 mb-1">
                <h3 class="text-base font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-hover)] transition-colors">
                  {post.data.title}
                </h3>
                <time class="font-mono text-xs text-[var(--color-text-muted)] whitespace-nowrap">
                  {post.data.pub_date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                </time>
              </div>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="contact" class="max-w-[var(--container-content)] mx-auto px-6 py-24 border-t border-[var(--color-border)]">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold text-[var(--color-text-primary)] mb-4">
        Let&apos;s build something.
      </h2>
      <p class="text-[var(--color-text-secondary)] mb-8 leading-relaxed">
        Working on an early-stage AI startup? Hiring for the Exponential
        Fellowship cohort? Have a project I&apos;d obviously want in on?
        Email is the best way to find me.
      </p>
      <a
        href="mailto:alfonsomayoral29@gmail.com"
        class="inline-flex items-center px-6 py-3 rounded-md bg-[var(--color-accent)] text-white font-medium text-sm hover:bg-[var(--color-accent-hover)] transition-colors"
      >
        alfonsomayoral29@gmail.com
      </a>
    </div>
  </section>
</BaseLayout>
