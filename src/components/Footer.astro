---
const year = new Date().getFullYear();

const socials = [
  { href: 'mailto:alfonsomayoral29@gmail.com', label: 'Email' },
  { href: 'https://github.com/alfonsomayoral', label: 'GitHub' },
  { href: 'https://linkedin.com/in/alfonsomayoral', label: 'LinkedIn' },
];
---

<footer class="border-t border-[var(--color-border)] mt-32">
  <div class="max-w-[var(--container-content)] mx-auto px-6 py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="text-sm text-[var(--color-text-muted)]">
      <p class="font-mono">Alfonso Mayoral · Madrid</p>
      <p class="mt-1">Built with Astro. Source on <a href="https://github.com/alfonsomayoral/portfolio" class="underline hover:text-[var(--color-text-secondary)]">GitHub</a>.</p>
    </div>

    <div class="flex items-center gap-6">
      {
        socials.map((s) => (
          <a
            href={s.href}
            class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
  <div class="max-w-[var(--container-content)] mx-auto px-6 pb-8 text-xs text-[var(--color-text-muted)]">
    © {year}
  </div>
</footer>
