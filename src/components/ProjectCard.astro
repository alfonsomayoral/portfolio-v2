---
import Tag from './Tag.astro';

interface Props {
  title: string;
  tagline: string;
  tech?: string[];
  year?: number | string;
  status?: string;
  href: string;
  image?: string;
}

const { title, tagline, tech = [], year, status, href, image } = Astro.props;
---

<a
  href={href}
  class="group block p-6 bg-[var(--color-bg-elevated)] border border-[var(--color-border)] rounded-lg hover:border-[var(--color-border-strong)] transition-all duration-300"
>
  {
    image && (
      <div class="aspect-[16/9] mb-4 overflow-hidden rounded-md bg-[var(--color-bg)]">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="text-lg font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-hover)] transition-colors">
      {title}
    </h3>
    {
      (year || status) && (
        <div class="flex items-center gap-2 text-xs text-[var(--color-text-muted)] font-mono whitespace-nowrap">
          {year && <span>{year}</span>}
          {status && (
            <>
              <span>·</span>
              <span>{status}</span>
            </>
          )}
        </div>
      )
    }
  </div>

  <p class="text-sm text-[var(--color-text-secondary)] mb-4 leading-relaxed">
    {tagline}
  </p>

  {
    tech.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tech.slice(0, 5).map((t) => <Tag label={t} />)}
      </div>
    )
  }
</a>
