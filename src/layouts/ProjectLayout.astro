---
import BaseLayout from './BaseLayout.astro';
import Prose from '@/components/Prose.astro';
import Tag from '@/components/Tag.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;

const allProjects = await getCollection('projects');
const related = allProjects
  .filter((p) => p.id !== project.id)
  .sort(() => Math.random() - 0.5)
  .slice(0, 2);

const statusStyles: Record<string, string> = {
  shipped: 'text-emerald-400',
  'in-progress': 'text-amber-400',
  archived: 'text-zinc-500',
  research: 'text-sky-400',
};
---

<BaseLayout title={`${data.title} — Alfonso Mayoral`} description={data.tagline}>
  <article>
    <header class="max-w-[var(--container-narrow)] mx-auto px-6 pt-32 pb-12">
      <a
        href="/projects"
        class="inline-block font-mono text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text-secondary)] mb-8 transition-colors"
      >
        ← All projects
      </a>

      <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-[var(--color-text-primary)] mb-4">
        {data.title}
      </h1>
      <p class="text-xl text-[var(--color-text-secondary)] leading-relaxed mb-8">
        {data.tagline}
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-mono text-[var(--color-text-muted)] mb-6">
        {data.year && <span>{data.year}</span>}
        {data.role && (
          <>
            <span class="opacity-50">·</span>
            <span>{data.role}</span>
          </>
        )}
        <span class="opacity-50">·</span>
        <span class={statusStyles[data.status] ?? ''}>
          {data.status}
        </span>
      </div>

      {
        data.tech_stack.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {data.tech_stack.map((t) => (
              <Tag label={t} />
            ))}
          </div>
        )
      }

      {
        data.links && (
          <div class="flex flex-wrap gap-4 text-sm">
            {data.links.live && (
              <a
                href={data.links.live}
                target="_blank"
                rel="noopener"
                class="text-[var(--color-accent-hover)] hover:underline"
              >
                Live →
              </a>
            )}
            {data.links.appstore && (
              <a
                href={data.links.appstore}
                target="_blank"
                rel="noopener"
                class="text-[var(--color-accent-hover)] hover:underline"
              >
                App Store →
              </a>
            )}
            {data.links.repo && (
              <a
                href={data.links.repo}
                target="_blank"
                rel="noopener"
                class="text-[var(--color-accent-hover)] hover:underline"
              >
                Source →
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      data.hero_image && (
        <div class="max-w-[var(--container-content)] mx-auto px-6 mb-16">
          <img
            src={data.hero_image}
            alt={data.title}
            class="w-full rounded-lg border border-[var(--color-border)]"
          />
        </div>
      )
    }

    <div class="pb-24">
      <Prose>
        <slot />
      </Prose>
    </div>

    {
      data.nda && (
        <div class="max-w-[var(--container-narrow)] mx-auto px-6 pb-16">
          <div class="p-6 border border-[var(--color-border)] rounded-md bg-[var(--color-bg-elevated)] text-sm text-[var(--color-text-secondary)] leading-relaxed">
            <p class="font-mono text-xs text-[var(--color-text-muted)] uppercase tracking-wider mb-2">
              NDA disclaimer
            </p>
            <p>
              This case study presents a sanitized, generalized representation
              of work performed during my employment at a private company. All
              product names, customer names, data, metrics (in absolute terms),
              screenshots, and code samples have been mocked, abstracted, or
              omitted. The architectural patterns and technical approaches
              reflect publicly shareable knowledge and engineering principles.
            </p>
          </div>
        </div>
      )
    }

    {
      related.length > 0 && (
        <section class="max-w-[var(--container-content)] mx-auto px-6 pb-32 border-t border-[var(--color-border)] pt-16">
          <h2 class="text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-wider mb-6">
            More projects
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {related.map((p) => (
              <ProjectCard
                title={p.data.title}
                tagline={p.data.tagline}
                tech={p.data.tech_stack}
                year={p.data.year}
                status={p.data.status}
                href={`/projects/${p.id}`}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
